# Optional overrides. Copy to .env only if needed; never commit credentials.
HINDSIGHT_API_PORT=8888
HINDSIGHT_UI_PORT=9999
HINDSIGHT_API_LLM_PROVIDER=github-copilot
HINDSIGHT_API_LLM_MODEL=gpt-6-luna
HINDSIGHT_API_ENABLE_OBSERVATIONS=false

# Optional LLM overrides. Leave commented to keep the global settings.
# Check that the selected provider and model support the reasoning effort.
# HINDSIGHT_API_LLM_REASONING_EFFORT=low
#
# If changing a provider, specify its model and, when needed, its URL and key.
# Retain:
# HINDSIGHT_API_RETAIN_LLM_PROVIDER=github-copilot
# HINDSIGHT_API_RETAIN_LLM_MODEL=gpt-6-luna
# HINDSIGHT_API_RETAIN_LLM_REASONING_EFFORT=low
# HINDSIGHT_API_RETAIN_LLM_BASE_URL=https://your-provider.example/v1
# HINDSIGHT_API_RETAIN_LLM_API_KEY=configure-privately
#
# Reflect:
# HINDSIGHT_API_REFLECT_LLM_PROVIDER=github-copilot
# HINDSIGHT_API_REFLECT_LLM_MODEL=gpt-6-luna
# HINDSIGHT_API_REFLECT_LLM_REASONING_EFFORT=low
# HINDSIGHT_API_REFLECT_LLM_BASE_URL=https://your-provider.example/v1
# HINDSIGHT_API_REFLECT_LLM_API_KEY=configure-privately
#
# Consolidation (does not enable observations):
# HINDSIGHT_API_CONSOLIDATION_LLM_PROVIDER=github-copilot
# HINDSIGHT_API_CONSOLIDATION_LLM_MODEL=gpt-6-luna
# HINDSIGHT_API_CONSOLIDATION_LLM_REASONING_EFFORT=low
# HINDSIGHT_API_CONSOLIDATION_LLM_BASE_URL=https://your-provider.example/v1
# HINDSIGHT_API_CONSOLIDATION_LLM_API_KEY=configure-privately

# For a future OpenAI-compatible provider on the VM:
# HINDSIGHT_API_LLM_PROVIDER=openai
# HINDSIGHT_API_LLM_MODEL=your-model
# HINDSIGHT_API_LLM_BASE_URL=https://your-provider.example/v1
# HINDSIGHT_API_LLM_API_KEY=configure-privately
